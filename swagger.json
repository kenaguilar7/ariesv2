              "schema": {
                "$ref": "#/components/schemas/JournalEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/JournalEntry/GetConsecutiveNumber/{postingPeriodId}": {
      "get": {
        "tags": ["Journal Entries"],
        "summary": "Get consecutive number for journal entry",
        "parameters": [
          {
            "name": "postingPeriodId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New consecutive number"
          }
        }
      }
    },
    "/JournalEntry/GetJournalEntries/{postingPeriodId}": {
      "get": {
        "tags": ["Journal Entries"],
        "summary": "Get journal entries for a posting period",
        "parameters": [
          {
            "name": "postingPeriodId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of journal entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JournalEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/JournalEntry/UpdateJournalEntry": {
      "post": {
        "tags": ["Journal Entries"],
        "summary": "Update a journal entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry updated successfully"
          }
        }
      }
    },
    "/JournalEntry/DeleteJournalEntry": {
      "post": {
        "tags": ["Journal Entries"],
        "summary": "Delete a journal entry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry deleted successfully"
          }
        }
      }
    },
    "/JournalEntryLine/CreateJournalEntryLine": {
      "post": {
        "tags": ["Journal Entry Lines"],
        "summary": "Create a new journal entry line",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntryLine"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry line ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/JournalEntryLine/DeleteJournalEntryLine": {
      "post": {
        "tags": ["Journal Entry Lines"],
        "summary": "Delete a journal entry line",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntryLine"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry line deleted successfully"
          }
        }
      }
    },
    "/JournalEntryLine/FindJournalEntryLine/{journalEntryId}": {
      "get": {
        "tags": ["Journal Entry Lines"],
        "summary": "Find journal entry lines by journal entry ID",
        "parameters": [
          {
            "name": "journalEntryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of journal entry lines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JournalEntryLine"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/JournalEntryLine/UpdateJournalEntryLine": {
      "post": {
        "tags": ["Journal Entry Lines"],
        "summary": "Update a journal entry line",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JournalEntryLine"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Journal entry line updated successfully"
          }
        }
      }
    },
    "/PostingPeriod/GetPostingPeriods/{companyId}": {
      "get": {
        "tags": ["Posting Periods"],
        "summary": "Get posting periods for a company",
        "parameters": [
          {
            "name": "companyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of posting periods"
          }
        }
      }
    },
    "/Account/{companyId}/accounts": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get accounts for a company",
        "parameters": [
          {
            "name": "companyId",
            "in": "path",
            "required": true,
