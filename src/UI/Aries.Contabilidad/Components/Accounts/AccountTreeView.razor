@using Aries.Contabilidad.Models.Accounts
@using Aries.Contabilidad.Models.Enums
@using Aries.Contabilidad.Models.Utils

<MudPaper Class="pa-4">
    <MudTreeView T="Account" Items="@TreeViewItems" Hover="true" Dense="true" ExpandOnClick="true" SelectedValue="selectedAccount" SelectedValueChanged="HandleSelectedValueChanged">
        <ItemTemplate>
            <MudTreeViewItem Items="@(GetChildTreeItems(context.Value))" Value="@context.Value">
                <Content>
                    <div class="d-flex align-center gap-4 cursor-pointer">
                        <MudText>@context.Value.Name</MudText>
                        <MudText>@context.Value.Id</MudText>
                    </div>
                </Content>
            </MudTreeViewItem>
        </ItemTemplate>
    </MudTreeView>
</MudPaper>

@code {
    [Parameter]
    public List<Account> Accounts { get; set; } = new();

    [Parameter]
    public EventCallback<Account> OnAccountSelected { get; set; }

    private Account selectedAccount;

    private IReadOnlyCollection<TreeItemData<Account>> TreeViewItems =>
        RootAccounts.Select(a => new TreeItemData<Account>
            {
                Value = a,
                Text = a.Name,
                Expanded = true // Opcional: expandir nodos por defecto
            }).ToList().AsReadOnly();

    private IEnumerable<Account> RootAccounts => Accounts.Where(a => !a.FatherAccount.HasValue);

    private IReadOnlyCollection<TreeItemData<Account>> GetChildTreeItems(Account parent)
    {
        return Accounts
            .Where(a => a.FatherAccount == parent.Id)
            .Select(a => new TreeItemData<Account>
                {
                    Value = a,
                    Text = a.Name,
                    Expanded = false
                })
            .ToList()
            .AsReadOnly();
    }

    private async Task HandleSelectedValueChanged(Account account)
    {
        if (account != null)
        {
            await OnAccountSelected.InvokeAsync(account);
        }
    }
}