@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.PostingPeriods

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="int"
                   Value="PostingPeriodId"
                   ValueChanged="@(async (int val) => await PostingPeriodIdChanged.InvokeAsync(val))"
                   Label="Posting Period"
                   Variant="Variant.Outlined"
                   Immediate="true">
            @if (PostingPeriods != null)
            {
                @foreach (var period in PostingPeriods)
                {
                    <MudSelectItem Value="@period.Id">@period.ToString()</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="JournalEntryDto"
                   Value="JournalEntry"
                   ValueChanged="@(async (JournalEntryDto val) => await JournalEntryIdChanged.InvokeAsync(val))"
                   Label="Journal Entry Number"
                   Variant="Variant.Outlined"
                   Immediate="true">
            @if (JournalEntries != null)
            {
                @foreach (var entry in JournalEntries)
                {
                    <MudSelectItem Value="@entry">@entry.Number</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>

</MudGrid>

@code {

    // [Parameter]
    // public int JournalEntryId { get; set; }

    [Parameter]
    public JournalEntryDto JournalEntry { get; set; } = new();

    [Parameter]
    public int PostingPeriodId { get; set; }

    [Parameter]
    public EventCallback<JournalEntryDto> JournalEntryIdChanged { get; set; }

    [Parameter]
    public EventCallback<int> PostingPeriodIdChanged { get; set; }

    [Parameter]
    public List<PostingPeriodDto> PostingPeriods { get; set; } = new();

    [Parameter]
    public List<JournalEntryDto> JournalEntries { get; set; } = new();

}
