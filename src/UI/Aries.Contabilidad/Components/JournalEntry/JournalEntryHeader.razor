@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.PostingPeriods

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="int"
                   Value="PostingPeriodId"
                   ValueChanged="@(async (int val) => { await PostingPeriodIdChanged.InvokeAsync(val); await OnPostingPeriodChanged.InvokeAsync(val); })"
                   Label="Posting Period"
                   Variant="Variant.Outlined">
            @if (PostingPeriods != null)
            {
                @foreach (var period in PostingPeriods)
                {
                    <MudSelectItem Value="@period.Id">@period.ToString()</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="int"
                   Value="JournalEntryId"
                   ValueChanged="JournalEntryIdChanged"
                   Label="Journal Entry Number"
                   Variant="Variant.Outlined">
            @if (JournalEntries != null)
            {
                @foreach (var entry in JournalEntries)
                {
                    <MudSelectItem Value="@entry.Id">@entry.Number</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>

</MudGrid>

@code {

    /// <summary>
    /// The journal entry number
    /// </summary>
    [Parameter]
    public int JournalEntryId { get; set; }

    /// <summary>
    /// Event callback for number changes
    /// </summary>
    [Parameter]
    public EventCallback<int> JournalEntryIdChanged { get; set; }

    /// <summary>
    /// The selected posting period ID
    /// </summary>
    [Parameter]
    public int PostingPeriodId { get; set; }

    /// <summary>
    /// Event callback for posting period changes
    /// </summary>
    [Parameter]
    public EventCallback<int> PostingPeriodIdChanged { get; set; }

    /// <summary>
    /// List of available posting periods
    /// </summary>
    [Parameter]
    public List<PostingPeriodDto> PostingPeriods { get; set; } = new();

    /// <summary>
    /// Event callback when posting period is changed
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPostingPeriodChanged { get; set; }

    /// <summary>
    /// List of available journal entries
    /// </summary>
    [Parameter]
    public List<JournalEntryDto> JournalEntries { get; set; } = new();
}
