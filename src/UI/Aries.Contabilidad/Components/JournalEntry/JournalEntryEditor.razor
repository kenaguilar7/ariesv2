@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.PostingPeriods
@using Aries.Contabilidad.Models.Utils
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json

<EditForm Model="@JournalEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">@Title</MudText>

        <JournalEntryHeader 
        JournalEntry="JournalEntry"
        PostingPeriodId="JournalEntry.PostingPeriodId"
        JournalEntryIdChanged="HandleJournalEntryIdChanged"
        PostingPeriodIdChanged="HandlePostingPeriodChanged"
        PostingPeriods="@_postingPeriods"
        JournalEntries="@_journalEntries" />

        <JournalEntryLinesEditor 
        Lines="@JournalEntry.Lines"
        OnLineChanged="HandleLineChanged"
        OnLineDeleted="HandleLineDeleted" 
        CompanyId="@CompanyId"/>

        <JournalEntrySummary 
        TotalDebit="@_totalDebit"
        TotalCredit="@_totalCredit"
        IsBalanced="@IsBalanced" />

@*         <MudPaper Class="d-flex justify-end pa-4 mt-4 gap-4">
            <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="OnCancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Type="submit" Disabled="@(!IsBalanced)">Save</MudButton>
        </MudPaper> *@
    </MudContainer>
</EditForm>

@code {
    [Parameter]
    public string CompanyId { get; set; } 

    /// <summary>
    /// Title of the editor form
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Create Journal Entry";

    /// <summary>
    /// Callback invoked when the journal entry is saved
    /// </summary>
    [Parameter]
    public EventCallback<JournalEntryDto> OnSave { get; set; }

    /// <summary>
    /// Callback invoked when editing is cancelled
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// The journal entry model being edited
    /// </summary>
    [Parameter]
    public JournalEntryDto JournalEntry { get; set; } = default!;

    private List<PostingPeriodDto> _postingPeriods = new();
    private List<JournalEntryDto> _journalEntries = new();
    private decimal _totalDebit;
    private decimal _totalCredit;

    [Inject]
    private IPostingPeriodService PostingPeriodService { get; set; } = default!;

    [Inject]
    private IJournalEntryService JournalEntryService { get; set; } = default!;

    [Inject]
    private IJournalEntryLineService JournalEntryLineService { get; set; } = default!;

    [Inject]
    private ILocalStorageService LocalStorageService { get; set; } = default!;

    /// <summary>
    /// Indicates whether debits and credits are balanced
    /// </summary>
    public bool IsBalanced => Math.Abs(_totalDebit - _totalCredit) < 0.01m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _postingPeriods = await PostingPeriodService.GetPostingPeriodsAsync(CompanyId);
            var lastPostingPeriod = _postingPeriods.OrderByDescending(p => p.Date).FirstOrDefault();
            if (lastPostingPeriod != null)
            {
                await HandlePostingPeriodChanged(lastPostingPeriod.Id);
            }
            CalculateTotals();
        }
        catch (Exception ex)
        {
            // Handle error appropriately
        }
    }

    private async Task<List<JournalEntryDto>> GetConsecutiveNumberAsync(int postingPeriodId)
    {
        var allJournalEntries = await JournalEntryService.GetJournalEntriesAsync(postingPeriodId, new JournalEntryFilter());    
        var newJournalEntryId = await JournalEntryService.GetConsecutiveNumberAsync(postingPeriodId);

        JournalEntry = new JournalEntryDto
            {
            // CompanyId = CompanyId,
                Id = 0,
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now,
                Status = JournalEntryStatus.Draft,
                PostingPeriodId = postingPeriodId,
                Number = newJournalEntryId,
                IsPosted = false,
                Lines = new List<JournalEntryLineDto>()
            };
        allJournalEntries.Add(JournalEntry);
        return allJournalEntries;
    }

    private void CalculateTotals()
    {
        _totalDebit = JournalEntry.Lines
            .Where(l => l.DebOrCred == DebOrCred.Debito)
            .Sum(l => l.Amount);

        _totalCredit = JournalEntry.Lines
            .Where(l => l.DebOrCred == DebOrCred.Credito)
            .Sum(l => l.Amount);
    }

    private async Task HandlePostingPeriodChanged(int periodId)
    {
        _journalEntries = await GetConsecutiveNumberAsync(periodId);
        StateHasChanged(); 
    }

    private async Task HandleJournalEntryIdChanged(JournalEntryDto journalEntry)
    {

        JournalEntry = journalEntry;

        if (journalEntry.Id == 0)
        {
            JournalEntry.Id = await JournalEntryService.CreateJournalEntryAsync(journalEntry);
        }
        else
        {
            var existingLines = await JournalEntryLineService.GetJournalEntryLinesAsync(journalEntry.Id);
            if (existingLines != null)
                journalEntry.Lines = existingLines;
            else
                journalEntry.Lines = new List<JournalEntryLineDto>();

        }
        CalculateTotals();
        StateHasChanged();
    }

    private async void HandleLineChanged(JournalEntryLineDto line)
    {
        if (JournalEntry.Id == 0)
            JournalEntry.Id = await JournalEntryService.CreateJournalEntryAsync(JournalEntry);

        line.JournalEntryId = JournalEntry.Id;
        var user = await LocalStorageService.GetCurrentUserSesion();
        line.CreatedBy = user.Id; 
        line.UpdatedBy = user.Id;

        if (line.Id == 0)
        {
            await JournalEntryLineService.CreateJournalEntryLineAsync(line);
            JournalEntry.Lines.Add(line);
        }
        else
        {
            await JournalEntryLineService.UpdateJournalEntryLineAsync(line);
        };

        await JournalEntryService.UpdateJournalEntryAsync(JournalEntry);

        CalculateTotals();
        StateHasChanged();
    }

    private async void HandleLineDeleted(JournalEntryLineDto line)
    {
        await JournalEntryLineService.DeleteJournalEntryLineAsync(line);
        JournalEntry.Lines.Remove(line);
        CalculateTotals();
        StateHasChanged();
    }

    // private async Task HandleValidSubmit()
    // {
    //     if (IsBalanced)
    //     {
    //         await OnSave.InvokeAsync(JournalEntry);
    //     }
    // }
}
