@using Aries.Contabilidad.Models.Accounts
@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.Utils

<MudTd ColSpan="2">
    @* <MudToggleIconButton @bind-Toggled="@_open" Icon="@Icons.Material.Filled.Fullscreen" Color="@Color.Primary" ToggledIcon="@Icons.Material.Filled.FullscreenExit" ToggledColor="@Color.Secondary" /> *@

@*     <MudPopover Open="@_open"
                Fixed="true"
                AnchorOrigin="Origin.CenterCenter"
                TransformOrigin="Origin.CenterCenter"
                Class="account-selector-popover"
                Style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1300;">
        <div class="popover-container" style="pointer-events: auto;">
            <div class="popover-content">
                <div class="scrollable-treeview">
                    <AccountTreeView Accounts="@Accounts" OnAccountSelected="HandleAccountSelected" />
                </div>
                <div class="popover-actions">
                    <MudButton OnClick="@ToggleOpen" Color="Color.Error" Variant="Variant.Text" Size="Size.Small">
                        Cerrar
                    </MudButton>
                </div>
            </div>
        </div>
    </MudPopover> *@

    <MudExpansionPanel Text="@(Line.AccountName ?? string.Empty)">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Buscar cuenta..."
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      Icon="@Icons.Material.Filled.Search"
                      Class="mb-2" />
        <div class="scrollable-treeview">
            <AccountTreeView Accounts="@Accounts" OnAccountSelected="HandleAccountSelected" />
        </div>
    </MudExpansionPanel>

    <MudTextField @bind-Value="Line.Memo"
    Label="Memo"
    Variant="Variant.Outlined"
    Dense="true"
    Class="flex-grow-1" />
</MudTd>

<MudTd ColSpan="2">
    <MudSelect T="Currency"
    @bind-Value="Line.Currency"
    Label="Currency"
    Variant="Variant.Outlined"
    Dense="true"
    Style="width: 150px">
        <MudSelectItem Value="Currency.colones">Colones</MudSelectItem>
        <MudSelectItem Value="Currency.dolares">Dólares</MudSelectItem>
    </MudSelect>
    <MudNumericField Value="Line.RateAmount"
    Label="Exchange Rate"
    Variant="Variant.Outlined"
    Dense="true"
    Format="N4"
    Min="0"
    Style="width: 150px"
    Immediate="true" />
</MudTd>

<MudTd ColSpan="2">
    <MudNumericField @bind-Value="DebitAmount"
    Label="@($"{(Line.Currency == Currency.dolares ? "USD" : "CRC")} Debit")"
    Variant="Variant.Outlined"
    Dense="true"
    Format="N2"
    Min="0"
    Class="flex-grow-1"/>

    <MudNumericField @bind-Value="CreditAmount"
    Label="@($"{(Line.Currency == Currency.dolares ? "USD" : "CRC")} Credit")"
    Variant="Variant.Outlined"
    Dense="true"
    Format="N2"
    Min="0"
    Class="flex-grow-1" />


</MudTd>

<MudTd ColSpan="3" Style="text-align: right">
    <MudButton Color="Color.Success"
    StartIcon="@Icons.Material.Filled.Save"
    Disabled="@_isSaved"
    OnClick="HandleSave"
    Size="Size.Small"
    Variant="Variant.Filled">
        Save
    </MudButton>
    <MudButton Color="Color.Error"
    StartIcon="@Icons.Material.Filled.Cancel"
    OnClick="HandleCancel"
    Size="Size.Small"
    Class="ml-2"
    Variant="Variant.Filled">
        Cancel
    </MudButton>
</MudTd>

@code {
    private bool _isSaved = false;
    private bool _open;
    private void ToggleOpen() => _open = !_open;

    /// <summary>
    /// The journal entry line being edited
    /// </summary>
    [Parameter]
    public JournalEntryLineDto Line { get; set; } = default!;

    [Parameter]
    public string CompanyId { get; set; }
    /// <summary>
    /// Event callback when the line is changed
    /// </summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>
    /// Event callback when the line is deleted
    /// </summary>
    [Parameter]
    public EventCallback OnCancelAction { get; set; }

    [Inject]
    private IAccountService AccountService { get; set; } = default!;

    private List<Account> Accounts { get; set; } = new();
    private decimal DebitAmount { get; set; }
    private decimal CreditAmount {get; set; }

    private void OnRateAmountChanged(decimal newRate)
    {
        Line.RateAmount = newRate;
        if (newRate > 0 && Line.ForeignAmount > 0)
        {
            Line.Amount = Line.ForeignAmount * newRate;
        }
    }

    private async Task HandleSave()
    {

        if (Line.Currency == Currency.colones)
        {
            Line.Amount = Line.DebOrCred == DebOrCred.Debito ? DebitAmount : CreditAmount;
            Line.ForeignAmount = 0; 
        }
        else
        {
            Line.ForeignAmount = Line.DebOrCred == DebOrCred.Debito ? DebitAmount : CreditAmount;
            Line.Amount  = Line.ForeignAmount * Line.RateAmount;
        }

        if (Line.AccountId == 0 || Line.ForeignAmount == 0)
        {
            // return;s
        }

        _isSaved = true;
        await NotifyChange();
    }

    private async Task HandleCancel()
    {
       await OnCancelAction.InvokeAsync();
    }

    private string _searchText = string.Empty;
    private List<Account> _allAccounts = new();

    protected override void OnInitialized()
    {
        _allAccounts = Accounts; // Guardamos una copia de todas las cuentas
    }

    private IEnumerable<Account> FilteredAccounts =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allAccounts
            : _allAccounts.Where(a =>
                a.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                a.Id.ToString().Contains(_searchText));
        

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Accounts = await AccountService.GetAccountsAsync(CompanyId);
            DebitAmount = Line.DebOrCred == DebOrCred.Debito ? Line.Amount : 0;
            CreditAmount = Line.DebOrCred == DebOrCred.Credito ? Line.Amount : 0;
        }
        catch (Exception)
        {
            // Handle error appropriately
        }
    }

    private async Task NotifyChange()
    {
        await OnChange.InvokeAsync();
    }

    
    private void HandleAccountSelected(Account account)
    {
        if(account == null)
            return; 

        Line.AccountId = account.Id;
        Line.AccountName = account.Name; 
        StateHasChanged();
    }
}

<style>
    /* Fondo oscuro semi-transparente para mejor enfoque */
    .account-selector-popover .mud-overlay {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    /* Contenedor del popover centrado */
    .popover-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 400px;
        max-width: 90vw;
        max-height: 80vh;
        background: var(--mud-palette-surface);
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
    }

    /* Contenido del popover con padding */
    .popover-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* Scroll interno del TreeView */
    .scrollable-treeview {
        flex: 1;
        overflow-y: auto;
        max-height: 40vh;
        margin: -8px; /* Compensa el padding del contenedor */
        padding: 8px; /* Vuelve a agregar espacio para el scrollbar */
    }

    /* Botones de acción alineados a la derecha */
    .popover-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
    }
</style>