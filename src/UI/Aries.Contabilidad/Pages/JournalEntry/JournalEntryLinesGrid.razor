@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.Utils
@using MudBlazor

<MudPaper Class="pa-4">
    <MudDataGrid T="JournalEntryLineDto" 
                 Items="@JournalEntry?.Lines"
                 Dense="true"
                 Hover="true"
                 EditMode="DataGridEditMode.Form"
                 ReadOnly="@IsReadOnly"
                 CommittedItemChanges="OnCommittedItemChanges">
        <Columns>
            <PropertyColumn Property="x => x.AccountName" Title="Account" />
            <PropertyColumn Property="x => x.Reference" Title="Reference" />
            <PropertyColumn Property="x => x.Memo" Title="Memo" />
            <PropertyColumn Property="x => x.Date" Title="Date" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.Currency" Title="Currency" />
            <PropertyColumn Property="x => x.RateAmount" Title="Rate" Format="N2" />
            <PropertyColumn Property="x => x.ForeignAmount" Title="Foreign Amount" Format="N2" />
            <PropertyColumn Property="x => x.Amount" Title="Amount" Format="N2" />
            <PropertyColumn Property="x => x.DebOrCred" Title="Deb/Cred" />
            
            @if (!IsReadOnly)
            {
                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                     Size="Size.Small"
                                     OnClick="@(() => StartEditingItem(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                     Size="Size.Small"
                                     OnClick="@(() => DeleteItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>

        <PagerContent>
            <MudDataGridPager T="JournalEntryLineDto" />
        </PagerContent>
    </MudDataGrid>

    @if (!IsReadOnly)
    {
        <div class="d-flex justify-end mt-4">
            <MudButton Color="Color.Primary" 
                      OnClick="AddNewLine"
                      StartIcon="@Icons.Material.Filled.Add">
                Add Line
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public JournalEntryDto JournalEntry { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback<JournalEntryLineDto> OnLineAdded { get; set; }

    [Parameter]
    public EventCallback<JournalEntryLineDto> OnLineUpdated { get; set; }

    [Parameter]
    public EventCallback<JournalEntryLineDto> OnLineDeleted { get; set; }

    private async Task AddNewLine()
    {
        var newLine = new JournalEntryLineDto
        {
            JournalEntryId = JournalEntry.Id,
            Date = DateTime.Now,
            Currency = Currency.dolares,  // Default currency, adjust as needed
            RateAmount = 1,
            DebOrCred = DebOrCred.Debito  // Default value, adjust as needed
        };

        JournalEntry.Lines.Add(newLine);
        await OnLineAdded.InvokeAsync(newLine);
    }

    private async Task StartEditingItem(JournalEntryLineDto item)
    {
        // The grid will handle the editing mode
    }

    private async Task DeleteItem(JournalEntryLineDto item)
    {
        JournalEntry.Lines.Remove(item);
        await OnLineDeleted.InvokeAsync(item);
    }

    private async Task OnCommittedItemChanges(JournalEntryLineDto item)
    {
        await OnLineUpdated.InvokeAsync(item);
    }
}
