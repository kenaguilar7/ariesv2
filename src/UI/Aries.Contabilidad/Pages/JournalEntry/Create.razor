@page "/journal-entries/{CompanyId}/create"
@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Components.JournalEntry

@inject IJournalEntryService JournalEntryService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<JournalEntryEditor 
    JournalEntry="@_journalEntry"
    Title="Create Journal Entry"
    OnSave="HandleSave"
    OnCancel="HandleCancel"
    CompanyId="@CompanyId" />

@code {
    [Parameter]
    public string CompanyId { get; set; }

    private JournalEntryDto _journalEntry;

    protected override void OnInitialized()
    {
        _journalEntry = new JournalEntryDto
        {
            // CompanyId = CompanyId,
            Lines = new List<JournalEntryLineDto>(),
            Status = JournalEntryStatus.Draft,
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
    }

    private async Task HandleSave(JournalEntryDto journalEntry)
    {
        try
        {
            await JournalEntryService.CreateJournalEntryAsync(journalEntry);
            Snackbar.Add("Journal entry created successfully", Severity.Success);
            NavigationManager.NavigateTo($"/journal-entries/{CompanyId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to create journal entry", Severity.Error);
        }
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo($"/journal-entries/{CompanyId}");
    }
}
