@page "/journal-entries"
@using Aries.Contabilidad.Models.Accounts
@using Aries.Contabilidad.Models.JournalEntries
@using Aries.Contabilidad.Models.PostingPeriods
@using Aries.Contabilidad.Models.Utils
@using Aries.Contabilidad.Services
@using MudBlazor
@using static System.Net.WebRequestMethods
@inject IJournalEntryService JournalEntryService
@inject IAccountService AccountService
@inject IPostingPeriodService PostingPeriodService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4">
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Class="mb-4">Journal Entries</MudText>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudSelect T="int" Label="Posting Period" Value="selectedPostingPeriodId" 
                          ValueChanged="SetPostingPeriod">
                    @if (postingPeriods != null)
                    {
                        @foreach (var period in postingPeriods)
                        {
                            <MudSelectItem Value="@period.Id">@period.ToString()</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="8" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                          OnClick="OpenCreateDialog" Class="ml-2">
                    New Journal Entry
                </MudButton>
            </MudItem>

            <MudItem xs="12">
                <MudDataGrid T="JournalEntryDto" Items="@journalEntries" Dense="true" Hover="true"
                            FixedHeader="true" Height="400px">
                    <Columns>
                        <PropertyColumn Property="x => x.Number" Title="Number" />
                        <PropertyColumn Property="x => x.CreatedAt" Title="Date" Format="d" />
                        <PropertyColumn Property="x => x.Status" Title="Status" />
                        <PropertyColumn Property="x => x.TotalDebits" Title="Total Debits" Format="N2" />
                        <PropertyColumn Property="x => x.TotalCredits" Title="Total Credits" Format="N2" />
                        <TemplateColumn Title="Actions">
                            <CellTemplate>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                 OnClick="@(() => OpenEditDialog(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                                 Color="Color.Error"
                                                 OnClick="@(() => DeleteJournalEntry(context.Item))" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <ChildRowContent>
                        <MudCard Elevation="0">
                            <MudCardContent>
                                <MudDataGrid T="JournalEntryLineDto" Items="@context.Item.Lines" Dense="true">
                                    <Columns>
                                        <PropertyColumn Property="x => x.AccountName" Title="Account" />
                                        <PropertyColumn Property="x => x.Reference" Title="Reference" />
                                        <PropertyColumn Property="x => x.Memo" Title="Memo" />
                                        <PropertyColumn Property="x => x.Date" Title="Date" Format="d" />
                                        <PropertyColumn Property="x => x.Currency" Title="Currency" />
                                        <PropertyColumn Property="x => x.RateAmount" Title="Rate" Format="N2" />
                                        <PropertyColumn Property="x => x.Amount" Title="Amount" Format="N2" />
                                        <PropertyColumn Property="x => x.DebOrCred" Title="Type" />
                                    </Columns>
                                </MudDataGrid>
                            </MudCardContent>
                        </MudCard>
                    </ChildRowContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private List<JournalEntryDto> journalEntries;
    private List<PostingPeriod> postingPeriods;
    private List<Account> accounts;
    private int selectedPostingPeriodId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadPostingPeriods();
        if (postingPeriods?.Any() == true)
        {
            selectedPostingPeriodId = postingPeriods.First().Id;
            await LoadJournalEntries();
        }
    }

    private async Task SetPostingPeriod(int value)
    {
        selectedPostingPeriodId = value;
        await LoadJournalEntries();
    }

    private async Task LoadAccounts()
    {
        try
        {
            accounts = await AccountService.GetAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading accounts", Severity.Error);
        }
    }

    private async Task LoadPostingPeriods()
    {
        try
        {
            postingPeriods = await PostingPeriodService.GetPostingPeriodsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading posting periods", Severity.Error);
        }
    }

    private async Task LoadJournalEntries()
    {
        try
        {
            journalEntries = await JournalEntryService.GetJournalEntriesAsync(selectedPostingPeriodId);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading journal entries", Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        try
        {
            var consecutive = await JournalEntryService.GetConsecutiveNumberAsync(selectedPostingPeriodId);
            var parameters = new DialogParameters
            {
                ["Entry"] = new JournalEntryDto
                {
                    Number = consecutive,
                    PostingPeriodId = selectedPostingPeriodId,
                    Status = JournalEntryStatus.Progress,
                    CreatedAt = DateTime.Now,
                    UpdatedAt = DateTime.Now
                },
                ["Accounts"] = accounts
            };

            var dialog = await DialogService.ShowAsync<JournalEntryDialog>("New Journal Entry", parameters);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                var entry = (JournalEntryDto)result.Data;
                var id = await JournalEntryService.CreateJournalEntryAsync(entry);
                if (id > 0)
                {
                    await LoadJournalEntries();
                    Snackbar.Add("Journal entry created successfully", Severity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error creating journal entry", Severity.Error);
        }
    }

    private async Task OpenEditDialog(JournalEntryDto entry)
    {
        try
        {
            var parameters = new DialogParameters
            {
                ["Entry"] = entry,
                ["Accounts"] = accounts
            };

            var dialog = await DialogService.ShowAsync<JournalEntryDialog>("Edit Journal Entry", parameters);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                var updatedEntry = (JournalEntryDto)result.Data;
                await JournalEntryService.UpdateJournalEntryAsync(updatedEntry);
                await LoadJournalEntries();
                Snackbar.Add("Journal entry updated successfully", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error updating journal entry", Severity.Error);
        }
    }

    private async Task DeleteJournalEntry(JournalEntryDto entry)
    {
        try
        {
            await JournalEntryService.DeleteJournalEntryAsync(entry);
            await LoadJournalEntries();
            Snackbar.Add("Journal entry deleted successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error deleting journal entry", Severity.Error);
        }
    }
} 