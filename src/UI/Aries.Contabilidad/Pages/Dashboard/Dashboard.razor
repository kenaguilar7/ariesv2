@page "/dashboard/{CompanyId}"
@using Aries.Contabilidad.Models.DTOs
@using Aries.Contabilidad.Services
@using Aries.Contabilidad.Models.Accounts
@using Aries.Contabilidad.Components.Accounts
@inject IClientCompanyService CompanyService
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card h-100 cursor-pointer" @onclick="NavigateToJournalEntry">
                    <div class="card-body text-center">
                        <i class="fas fa-book fa-3x mb-3"></i>
                        <h3 class="card-title">Asientos Contables</h3>
                        <p class="card-text">Gestione sus asientos contables de manera eficiente</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-sitemap fa-2x me-2"></i>
                            <h3 class="card-title mb-0">Catálogo de Cuentas</h3>
                        </div>
                        @if (accounts != null)
                        {
                            <AccountTreeView Accounts="@accounts" />
                        }
                        else
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string CompanyId { get; set; }

    private bool isLoading = true;
    private List<Account> accounts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await AccountService.GetAccountsAsync(CompanyId);
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading accounts: {ex}");
            isLoading = false;
        }
        Console.WriteLine(CompanyId);
        // try
        // {
        //     company = await CompanyService.GetCompanyByIdAsync(CompanyId);
        //     if (company != null)
        //     {
        //         await LocalStorage.StoreCompanyInLocalStorage(company);
        //     }
        //     isLoading = false;
        // }
        // catch (Exception ex)
        // {
        //     // TODO: Add proper error handling
        //     Console.WriteLine($"Error loading company: {ex}");
        //     isLoading = false;
        // }
    }

    private void NavigateToJournalEntry()
    {
        NavigationManager.NavigateTo($"/journal-entries/{CompanyId}/create");
    }
} 